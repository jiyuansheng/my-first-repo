//集合的表示
#include <iostream>
#include <vector>

using namespace std;

//自定义的元素类型
typedef struct Node{
    int data;
    int parent;
    Node(int val):data(val),parent(-1){}
}Node;

//建立小顶堆,堆化过程
void heapify(vector<Node>& arr,int n,int i){
    int smallest=i;//假设当前节点为最小
    int left=2*i+1;//左子节点
    int right=2*i+2;
    //如果左子节点比当前节点小
    if(left<n&&arr[left].data<arr[smallest].data){
        smallest=left;
    }
    if(right<n&&arr[right].data<arr[smallest].data){
        smallest=right;
    }
    if(smallest!=i) {
        swap(arr[smallest], arr[i]);
        //继续堆化下面的子树
        heapify(arr, n, smallest);
    }
}

//建立堆
void buildMinHeap(vector<Node>& arr){
    int n=arr.size();
    //从最后一个非叶结点开始，向上堆化
    for(int i=n/2-1;i>=0;i--){
        heapify(arr,n,i);
    }
}
int main(){
    int num;//元素的个数
    cin>>num;
    vector<Node> input_tree(num,0);//输入的树的数据
    for(int i=0;i<num;i++){
        cin>>input_tree[i].data;
    }

    buildMinHeap(input_tree);
    for(int i=0;i<input_tree.size();i++){
        cout<<input_tree[i].data<<" ";
    }
    cout<<endl;
    return 0;
}
